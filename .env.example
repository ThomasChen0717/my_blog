# 复制此文件为 .env 并填入实际值（本地开发用，不要提交到 Git）

# Django 密钥（生产环境必须更换）
SECRET_KEY=your-secret-key-here

# 调试模式（生产设为 False）
DEBUG=True

# 允许的 Host（多个用逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库 URL（Render 会自动设置）
# 本地示例：postgres://user:pass@localhost:5432/dbname
DATABASE_URL=

# CSRF 相关（Render 会自动设置）
CSRF_TRUSTED_ORIGINS=http://localhost:8000
